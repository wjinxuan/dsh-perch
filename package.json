{
  "name": "@wjinxuan/dsh-perch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Dynamic-Island-style status panel for DeepSeek Harness that lives in the macOS notch.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "overlay"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": "wjinxuan",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "harness",
    "macos",
    "notch",
    "dynamic-island"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjinxuan/dsh-perch.git"
  },
  "homepage": "https://github.com/wjinxuan/dsh-perch#readme",
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  }
}
